{
  "name": "cinema-pwa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "db": "node scripts/pocketbase.mjs",
    "build": "tsc -b && tsc -p tsconfig.sw.json && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:feedback": "node --test tests/feedback.integration.mjs",
    "demo": "npm run build && node scripts/dev.mjs --preview"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "idb": "^8.0.4",
    "pocketbase": "^0.28.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "web-push": "3.6.7",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "fake-indexeddb": "^6.2.6",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
