<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <PublishProtocol>FileSystem</PublishProtocol>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <TargetFramework>net10.0</TargetFramework>
    <PublishDir>$(MSBuildProjectDirectory)\..\artifacts\release\</PublishDir>
    <PublishUrl>$(MSBuildProjectDirectory)\..\artifacts\release\</PublishUrl>
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <EnvironmentName>Production</EnvironmentName>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
  </PropertyGroup>
  <Target Name="CopyPostmanCollectionToArtifacts" AfterTargets="Publish"
          Condition="Exists('$(MSBuildProjectDirectory)\..\DanceSchoolApi.postman_collection.json')">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\DanceSchoolApi.postman_collection.json"
          DestinationFolder="$(MSBuildProjectDirectory)\..\artifacts" />
  </Target>
</Project>
